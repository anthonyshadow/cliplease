# Copy to .env.local (never committed). src/server/env.ts validates every value at boot.
# An empty value counts as unset.

# development | test | preview | production (07 D51; never NODE_ENV)
APP_ENV=development

# tunnel: https://dev.cliplease.com · production: https://cliplease.com (the one canonical origin; 07 D102)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# P03 sets the real URLs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cliplease_dev
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/cliplease_dev

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32
CRON_SECRET=

# Comma-separated, owner first (07 D88). P04 asks the owner to fill it.
ADMIN_EMAILS=

ENABLED_SOCIAL_PROVIDERS=mock
MOCK_SOCIAL_SCENARIO=default
PAYMENTS_DRIVER=fake
# cad only in the MVP; USD is P34
ENABLED_CURRENCIES=cad
STORAGE_DRIVER=local
PLATFORM_FEE_BPS=1000

# Unset = console email driver (development and test only)
RESEND_API_KEY=
# Unset = "<APP_NAME> <onboarding@resend.dev>" (07 D102)
EMAIL_FROM=
