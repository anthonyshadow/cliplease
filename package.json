{
  "name": "cliplease",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:tokens": "bash scripts/lint-tokens.sh",
    "lint:invariants": "tsx scripts/lint-invariants.ts",
    "cn:tables": "tsx scripts/cn-tables.ts",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed",
    "test:int": "vitest run --project integration",
    "test:int:changed": "vitest run --project integration --changed",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/test-db.sh",
    "check:full": "bash scripts/check.sh full",
    "check:step0": "bash scripts/check.sh step0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "email:dev": "email dev --dir src/emails/previews --port 3001",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
    "auth:schema": "bunx auth@1.7.7 generate --config src/server/auth/auth.ts --output src/db/schema/auth.ts --adapter drizzle --dialect postgresql --yes",
    "smoke:compat": "tsx scripts/compat-smoke.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@react-pdf/renderer": "4.9.0",
    "@vercel/functions": "3.9.9",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.49.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "resend": "6.31.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@next/env": "16.4.1",
    "@playwright/test": "1.63.0",
    "@react-email/ui": "6.11.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp"
  ],
  "trustedDependencies": [],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
